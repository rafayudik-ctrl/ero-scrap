# Local development only. Production runs on GitHub-hosted ephemeral runners.
# Never commit this file or place production credentials here.
# Private Pages Functions API endpoint. Use HTTPS in production.
# Local development example: http://127.0.0.1:8787/internal/collector
APP_ENV=development
COLLECTOR_API_URL=http://127.0.0.1:8787/internal/collector

# Must match RUNNER_API_TOKEN set as a secret on the API Worker.
# Generate at least 32 random bytes (64 hexadecimal characters).
COLLECTOR_API_TOKEN=replace-with-a-long-random-secret-token

# Only when AUTH_MODE="access" and /internal/* sits behind a Zero Trust policy.
# Leave both blank with the default password mode and for the local development Worker.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Keyword sources: SEARCH_KEYWORD (below) first, then config/search-keyword.txt.

# Local development only. In production, MEGA credentials are GitHub Actions secrets
# and the ephemeral runner logs in/out for each full/cleanup workflow.
MEGA_REMOTE_ROOT=/Ero-Scrap
MEGA_COMMAND_TIMEOUT_MS=120000
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe

# Optional: overrides config/search-keyword.txt (use a GitHub Actions secret in a public repo).
SEARCH_KEYWORD=
