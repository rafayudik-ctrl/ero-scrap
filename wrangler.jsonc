{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "ero-scrap",
  "pages_build_output_dir": "./apps/web/public",
  "compatibility_date": "2026-11-01",
  "vars": {
    "APP_ENV": "production",
    "WEB_ORIGIN": "https://ero-scrap.pages.dev",
    // Where thumbnails are kept. "d1" needs nothing else (default, no credit card).
    // To use R2 instead: change this to "r2" AND enable the r2_buckets line below.
    "THUMBNAIL_STORE": "d1",
    // Who may open the site. "password" (default) uses the SITE_PASSWORD secret: no extra
    // service, no credit card. "access" uses Cloudflare Zero Trust (see docs/CLOUD_DEPLOYMENT.md).
    "AUTH_MODE": "password"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ero-scrap-db",
      "database_id": "00000000-0000-4000-8000-000000000001",
      "migrations_dir": "database/migrations"
    }
  ],
  "r2_buckets": [
    // To use R2 instead of D1: remove the // from the next line (bucket must exist)
    // and set THUMBNAIL_STORE to "r2" above.
    // { "binding": "THUMBNAILS", "bucket_name": "ero-scrap-thumbnails" }
  ]
}
